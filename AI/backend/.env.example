# AI Backend Configuration Example
# Copy to .env and fill in your values

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================

# Redis URL for job queue
# Default: redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# ============================================================================
# DIRECTORY CONFIGURATION
# ============================================================================

# Directory for uploaded ballot images
UPLOAD_DIR=uploads

# Directory for processing results
RESULT_DIR=results

# ============================================================================
# AI PROCESSOR SELECTION
# ============================================================================

# Choose processor: mock, openai, google, tesseract, custom
# Default: mock (test data only)
AI_PROCESSOR=mock

# ============================================================================
# OPENAI VISION API CONFIGURATION
# ============================================================================

# Get your API key from: https://platform.openai.com/api-keys
# Only needed if AI_PROCESSOR=openai
OPENAI_API_KEY=sk-your-key-here

# ============================================================================
# GOOGLE CLOUD VISION CONFIGURATION
# ============================================================================

# Path to Google Cloud service account credentials JSON file
# Download from: https://console.cloud.google.com/iam-admin/serviceaccounts
# Only needed if AI_PROCESSOR=google
GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json

# ============================================================================
# CUSTOM ML MODEL CONFIGURATION
# ============================================================================

# Path to custom PyTorch model file
# Only needed if AI_PROCESSOR=custom
CUSTOM_MODEL_PATH=models/ballot_detector.pt

# ============================================================================
# EXAMPLE SETUPS
# ============================================================================

# SETUP 1: Testing with Mock Data (Default)
# Just use default values above, nothing else needed

# SETUP 2: OpenAI Vision API
# 1. Set AI_PROCESSOR=openai
# 2. Get API key from https://platform.openai.com/api-keys
# 3. Set OPENAI_API_KEY=sk-...
# 4. Run: export AI_PROCESSOR=openai && python3 AI/backend/app.py

# SETUP 3: Local Tesseract OCR (Free)
# 1. Set AI_PROCESSOR=tesseract
# 2. Install: pip install pytesseract pillow
# 3. Install Tesseract: brew install tesseract (macOS)
# 4. Run: export AI_PROCESSOR=tesseract && python3 AI/backend/app.py

# SETUP 4: Google Cloud Vision
# 1. Create project at https://console.cloud.google.com
# 2. Enable Vision API
# 3. Create service account and download credentials.json
# 4. Set GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json
# 5. Set AI_PROCESSOR=google
# 6. Install: pip install google-cloud-vision
# 7. Run: export AI_PROCESSOR=google && python3 AI/backend/app.py

# SETUP 5: Custom ML Model (Advanced)
# 1. Train or prepare your PyTorch model
# 2. Place at: AI/backend/models/ballot_detector.pt
# 3. Set CUSTOM_MODEL_PATH=models/ballot_detector.pt
# 4. Set AI_PROCESSOR=custom
# 5. Install: pip install torch torchvision opencv-python
# 6. Run: export AI_PROCESSOR=custom && python3 AI/backend/app.py
