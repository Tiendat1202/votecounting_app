generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  ADMIN
  USER
}

model Session {
  id         String      @id @default(cuid())
  name       String
  type       String
  startAt    DateTime
  endAt      DateTime
  candidates Candidate[]
  uploads    Upload[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model Candidate {
  id        String   @id @default(cuid())
  name      String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String
  // optional: số phiếu tổng hợp lưu nhanh
  votes     Int      @default(0)
}

model Upload {
  id        String   @id @default(cuid())
  filename  String
  original  String?
  size      Int?
  mimetype  String?
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String
  createdAt DateTime @default(now())
}

