# Server
PORT=5050
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_password
DB_DATABASE=votecounting_db

# JWT
JWT_SECRET=your_jwt_secret_key

# Email Configuration (Optional - for account approval notifications)
# Choose one of the following setups:
#
# Option 1: Gmail (recommended for testing)
# MAIL_SERVICE=gmail
# MAIL_USER=your_email@gmail.com
# MAIL_PASS=your_app_password  # Use App Password, not regular password
# MAIL_FROM=noreply@votecounting.com
#
# Option 2: Generic SMTP Server
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USER=your_email@example.com
# MAIL_PASS=your_password
# MAIL_FROM=noreply@votecounting.com
#
# Option 3: Disable email notifications
# Leave MAIL_USER and MAIL_PASS empty, and email will be logged to console

# AI Backend
AI_BACKEND_URL=http://localhost:8000
AI_PROCESSOR=mock